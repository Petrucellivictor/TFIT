{
  "name": "@tfit/database",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "dotenv -e ../apps/backend/.env.local -- drizzle-kit generate",
    "migrate": "dotenv -e ../apps/backend/.env.local -- drizzle-kit migrate",
    "push": "dotenv -e ../apps/backend/.env.local -- drizzle-kit push",
    "studio": "dotenv -e ../apps/backend/.env.local -- drizzle-kit studio",
    "seed": "dotenv -e ../apps/backend/.env.local -- tsx src/seed/run.ts",
    "upload-animations": "dotenv -e ../apps/backend/.env.local -- tsx src/seed/uploadExerciseAnimations.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@vercel/blob": "^1",
    "dotenv-cli": "^7.4.4",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4",
    "typescript": "^5.7.2"
  }
}
