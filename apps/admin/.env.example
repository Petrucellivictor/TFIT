# Reuses the same Neon database and Clerk instance as apps/backend — copy the
# values from apps/backend/.env.local (or `vercel env pull` once this app has
# its own Vercel project). This file documents what's required; it is not
# meant to be copied to `.env.local` with real values.

# Neon Postgres — same value as apps/backend's DATABASE_URL
DATABASE_URL=

# Clerk — same instance as apps/backend, so admin staff sign in with their
# normal TFIT account
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Comma-separated allowlist of emails permitted into the admin panel (see
# src/lib/adminAuth.ts and docs/SECURITY.md — no RBAC system exists yet)
ADMIN_EMAILS=
