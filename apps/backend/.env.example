# Provisioned via Vercel Marketplace — run `vercel env pull --yes` instead of
# filling these in by hand. This file documents what's required; it is not
# meant to be copied to `.env.local` with real values.

# Neon Postgres (Marketplace: neon)
DATABASE_URL=

# Clerk (Marketplace: clerk)
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk webhook (apps/backend/src/app/api/webhooks/clerk) — created manually
# in the Clerk dashboard once the app URL is known; not Marketplace-provisioned.
CLERK_WEBHOOK_SIGNING_SECRET=
