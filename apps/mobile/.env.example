# Clerk (Marketplace: clerk) — publishable key only, safe for the client
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# apps/backend URL: local dev (e.g. http://192.168.x.x:3000 — not localhost,
# a physical device/simulator can't reach your machine's localhost) or the
# deployed Vercel URL for tfit-backend.
EXPO_PUBLIC_API_URL=
